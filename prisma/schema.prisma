generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Province {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id         String   @id @default(cuid())
  name       String
  code       String?  @unique
  provinceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  vendors    Vendor[]

  @@unique([provinceId, name])
  @@index([provinceId])
}

model User {
  id                       String                 @id @default(cuid())
  name                     String
  email                    String?                @unique
  phone                    String?                @unique
  password                 String?
  role                     Role
  vendorId                 String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  processedRefunds         Refund[]               @relation("RefundProcessor")
  vendor                   Vendor?                @relation(fields: [vendorId], references: [id])
  processedBillingPayments VendorBillingPayment[] @relation("BillingProcessor")

  @@index([vendorId])
  @@index([role])
}

model Vendor {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  description     String?
  address         String?
  cityId          String?
  phone           String?
  email           String?              @unique
  logo            String?
  isActive        Boolean              @default(true)
  isHeld          Boolean              @default(false)
  legalName       String?
  npwp            String?              @unique
  siup            String?
  taxEnabled      Boolean              @default(false)
  taxRate         Decimal?             @db.Decimal(5, 2)
  taxName         String?              @default("PPN")
  acceptCash      Boolean              @default(true)
  platformFeeRate Decimal?             @db.Decimal(5, 2)
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  users           User[]
  vehicles        Vehicle[]
  city            City?                @relation(fields: [cityId], references: [id])
  billings        VendorBilling[]
  ewallets        VendorEWallet[]
  policies        VendorPolicy[]
  refundPolicies  VendorRefundPolicy[]
  settlements     VendorSettlement[]

  @@index([cityId])
  @@index([isActive])
  @@index([isHeld])
}

model VendorPolicy {
  id        String     @id @default(cuid())
  vendorId  String
  type      PolicyType
  title     String
  content   String
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type])
  @@index([vendorId])
  @@index([type])
  @@index([isActive])
}

model VendorRefundPolicy {
  id                   String   @id @default(cuid())
  vendorId             String
  hoursBeforeDeparture Int
  refundPercentage     Decimal  @db.Decimal(5, 2)
  description          String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  vendor               Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, hoursBeforeDeparture])
  @@index([vendorId])
  @@index([isActive])
}

model VendorEWallet {
  id          String      @id @default(cuid())
  type        EWalletType
  name        String
  accountName String
  accountNo   String
  isActive    Boolean     @default(true)
  vendorId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type, accountNo])
  @@index([vendorId])
  @@index([isActive])
}

model Vehicle {
  id           String        @id @default(cuid())
  licensePlate String        @unique
  name         String?
  brand        String
  model        String
  year         Int?
  capacity     Int
  color        String?
  status       VehicleStatus @default(ACTIVE)
  imageUrl     String?
  seatLayout   Json?
  vendorId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  trips        Trip[]
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

model Trip {
  id                String     @id @default(cuid())
  origin            String
  destination       String
  originDetail      String?
  destinationDetail String?
  departureTime     DateTime
  arrivalTime       DateTime?
  price             Decimal    @db.Decimal(12, 2)
  amenities         Amenity[]  @default([])
  minBooking        Int        @default(1)
  bookingDeadline   DateTime?
  status            TripStatus @default(SCHEDULED)
  notes             String?
  vehicleId         String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  bookings          Booking[]
  vehicle           Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  seats             TripSeat[]

  @@index([vehicleId])
  @@index([origin, destination])
  @@index([departureTime])
  @@index([status])
}

model TripSeat {
  id        String     @id @default(cuid())
  seatNo    String
  row       Int
  column    Int
  status    SeatStatus @default(AVAILABLE)
  tripId    String
  bookingId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  booking   Booking?   @relation(fields: [bookingId], references: [id])
  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNo])
  @@index([tripId])
  @@index([status])
  @@index([bookingId])
}

model Booking {
  id                String         @id @default(cuid())
  bookingCode       String         @unique
  customerName      String
  customerPhone     String
  customerEmail     String?
  tripId            String
  seatCount         Int
  subtotal          Decimal        @db.Decimal(12, 2)
  taxAmount         Decimal?       @db.Decimal(12, 2)
  totalAmount       Decimal        @db.Decimal(12, 2)
  platformFeeRate   Decimal?       @db.Decimal(5, 2)
  platformFeeAmount Decimal?       @db.Decimal(12, 2)
  vendorAmount      Decimal?       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus  @default(UNPAID)
  paidAt            DateTime?
  pgTransactionId   String?
  pgProvider        String?
  ewalletType       EWalletType?
  ewalletName       String?
  ewalletNo         String?
  status            BookingStatus  @default(PENDING)
  notes             String?
  expiresAt         DateTime?
  transferredFromId String?        @unique
  billingId         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  billing           VendorBilling? @relation(fields: [billingId], references: [id])
  transferredFrom   Booking?       @relation("BookingTransfer", fields: [transferredFromId], references: [id])
  transferredTo     Booking?       @relation("BookingTransfer")
  trip              Trip           @relation(fields: [tripId], references: [id])
  refunds           Refund[]
  seats             TripSeat[]

  @@index([tripId])
  @@index([customerPhone])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([billingId])
  @@index([createdAt])
}

model VendorBilling {
  id               String                 @id @default(cuid())
  invoiceNo        String                 @unique
  vendorId         String
  periodStart      DateTime
  periodEnd        DateTime
  dueDate          DateTime
  totalBookings    Int
  totalGrossAmount Decimal                @db.Decimal(14, 2)
  totalFeeAmount   Decimal                @db.Decimal(14, 2)
  paidAmount       Decimal                @default(0) @db.Decimal(14, 2)
  status           BillingStatus          @default(UNPAID)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  bookings         Booking[]
  refundDeductions Refund[]               @relation("RefundDeduction")
  vendor           Vendor                 @relation(fields: [vendorId], references: [id])
  payments         VendorBillingPayment[]

  @@unique([vendorId, periodStart, periodEnd])
  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
}

model VendorBillingPayment {
  id            String        @id @default(cuid())
  billingId     String
  amount        Decimal       @db.Decimal(14, 2)
  method        String
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  processedById String?
  createdAt     DateTime      @default(now())
  billing       VendorBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  processedBy   User?         @relation("BillingProcessor", fields: [processedById], references: [id])

  @@index([billingId])
}

model VendorSettlement {
  id               String           @id @default(cuid())
  settlementNo     String           @unique
  vendorId         String
  periodStart      DateTime
  periodEnd        DateTime
  totalBookings    Int
  totalGrossAmount Decimal          @db.Decimal(14, 2)
  totalFeeAmount   Decimal          @db.Decimal(14, 2)
  totalPgFeeAmount Decimal          @db.Decimal(14, 2)
  netAmount        Decimal          @db.Decimal(14, 2)
  status           SettlementStatus @default(PENDING)
  settledAt        DateTime?
  reference        String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  vendor           Vendor           @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([status])
  @@index([settledAt])
}

model Refund {
  id                      String         @id @default(cuid())
  refundCode              String         @unique
  bookingId               String
  originalAmount          Decimal        @db.Decimal(12, 2)
  refundPercentage        Decimal        @db.Decimal(5, 2)
  refundAmount            Decimal        @db.Decimal(12, 2)
  adminFee                Decimal?       @db.Decimal(12, 2)
  finalAmount             Decimal        @db.Decimal(12, 2)
  hoursBeforeDeparture    Int
  departureTime           DateTime
  requestedAt             DateTime       @default(now())
  refundMethod            RefundMethod
  customerBankName        String?
  customerBankAccount     String?
  customerBankAccountName String?
  status                  RefundStatus   @default(PENDING)
  reason                  String?
  rejectionReason         String?
  notes                   String?
  approvedAt              DateTime?
  processedAt             DateTime?
  completedAt             DateTime?
  processedById           String?
  deductedFromBillingId   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  booking                 Booking        @relation(fields: [bookingId], references: [id])
  deductedFromBilling     VendorBilling? @relation("RefundDeduction", fields: [deductedFromBillingId], references: [id])
  processedBy             User?          @relation("RefundProcessor", fields: [processedById], references: [id])

  @@index([bookingId])
  @@index([status])
  @@index([requestedAt])
}

enum Role {
  SUPER_ADMIN
  OWNER
  STAFF
  DRIVER
}

enum TripStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum EWalletType {
  GOPAY
  OVO
  DANA
  SHOPEEPAY
  LINKAJA
  OTHER
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  BROKEN
  BLOCKED
}

enum PaymentMethod {
  CASH
  EWALLET
  TRANSFER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
  TRANSFERRED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  SETTLED
  HELD
}

enum BillingStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum RefundMethod {
  ORIGINAL
  BANK_TRANSFER
  CASH_PICKUP
  CREDIT
}

enum Amenity {
  AC
  TOLL
  USB
  BLANKET
  SNACK
  DRINK
  WIFI
  TV
  TOILET
  RECLINING_SEAT
  LEGROOM
  LUGGAGE
}

enum PolicyType {
  RESCHEDULE
  CANCELLATION
  REFUND
  LUGGAGE
  DEPARTURE
  DISCLAIMER
  OTHER
}
