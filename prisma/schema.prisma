generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Province {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id         String   @id @default(cuid())
  name       String
  code       String?  @unique
  provinceId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  vendors    Vendor[]

  @@unique([provinceId, name])
  @@index([provinceId])
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id                       String                 @id @default(cuid())
  name                     String
  email                    String?                @unique
  phone                    String?                @unique
  password                 String?
  roleId                   String
  vendorId                 String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  role                     Role                   @relation(fields: [roleId], references: [id])
  processedRefunds         Refund[]               @relation("RefundProcessor")
  vendor                   Vendor?                @relation(fields: [vendorId], references: [id])
  processedBillingPayments VendorBillingPayment[] @relation("BillingProcessor")
  driverTrips              Trip[]                 @relation("DriverTrips")
  templateSchedules        TripTemplateSchedule[] @relation("DriverTemplateSchedules")
  profile                  UserProfile?
  passwordResetTokens      PasswordResetToken[]

  @@index([vendorId])
  @@index([roleId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  fullName  String?
  birthDate DateTime?
  gender    Gender?
  photoUrl  String?
  address   String?
  // Driver-specific fields
  simNumber String?   @unique
  ktpNumber String?   @unique
  ktpImage  String?
  simImage  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Vendor {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  description     String?
  address         String?
  cityId          String?
  phone           String?
  email           String?              @unique
  logo            String?
  isActive        Boolean              @default(true)
  isHeld          Boolean              @default(false)
  legalName       String?
  npwp            String?              @unique
  siup            String?
  taxEnabled      Boolean              @default(false)
  taxRate         Decimal?             @db.Decimal(5, 2)
  taxName         String?              @default("PPN")
  acceptCash      Boolean              @default(true)
  platformFeeRate Decimal?             @db.Decimal(5, 2)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  users           User[]
  vehicles        Vehicle[]
  city            City?                @relation(fields: [cityId], references: [id])
  billings        VendorBilling[]
  ewallets        VendorEWallet[]
  policies        VendorPolicy[]
  refundPolicies  VendorRefundPolicy[]
  settlements     VendorSettlement[]
  wallet          VendorWallet?
  tripTemplates   TripTemplate[]

  @@index([cityId])
  @@index([isActive])
  @@index([isHeld])
}

model VendorPolicy {
  id        String     @id @default(cuid())
  vendorId  String
  type      PolicyType
  title     String
  content   String
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type])
  @@index([vendorId])
  @@index([type])
  @@index([isActive])
}

model VendorRefundPolicy {
  id                   String   @id @default(cuid())
  vendorId             String
  hoursBeforeDeparture Int
  refundPercentage     Decimal  @db.Decimal(5, 2)
  description          String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  vendor               Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, hoursBeforeDeparture])
  @@index([vendorId])
  @@index([isActive])
}

model VendorEWallet {
  id          String      @id @default(cuid())
  type        EWalletType
  name        String
  accountName String
  accountNo   String
  isActive    Boolean     @default(true)
  vendorId    String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, type, accountNo])
  @@index([vendorId])
  @@index([isActive])
}

model Vehicle {
  id                String                 @id @default(cuid())
  licensePlate      String                 @unique
  name              String?
  brand             String
  model             String
  year              Int?
  capacity          Int
  color             String?
  status            VehicleStatus          @default(ACTIVE)
  imageUrl          String?
  seatLayout        Json?
  vendorId          String
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  trips             Trip[]
  vendor            Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  templateSchedules TripTemplateSchedule[]

  @@index([vendorId])
  @@index([status])
}

model Trip {
  id                String        @id @default(cuid())
  origin            String
  destination       String
  originDetail      String?
  destinationDetail String?
  departureTime     DateTime
  arrivalTime       DateTime?
  originLat         Float?
  originLng         Float?
  price             Decimal       @db.Decimal(12, 2)
  amenities         Amenity[]     @default([])
  minBooking        Int           @default(1)
  bookingDeadline   DateTime?
  status            TripStatus    @default(SCHEDULED)
  notes             String?
  vehicleId         String
  driverId          String?
  templateId        String?
  scheduleId        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bookings          Booking[]
  vehicle           Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver            User?         @relation("DriverTrips", fields: [driverId], references: [id])
  template          TripTemplate? @relation("TripFromTemplate", fields: [templateId], references: [id])
  seats             TripSeat[]

  @@index([vehicleId])
  @@index([driverId])
  @@index([templateId])
  @@index([origin, destination])
  @@index([departureTime])
  @@index([status])
}

model TripSeat {
  id        String     @id @default(cuid())
  seatNo    String
  row       Int
  column    Int
  status    SeatStatus @default(AVAILABLE)
  tripId    String
  bookingId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  booking   Booking?   @relation(fields: [bookingId], references: [id])
  trip      Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatNo])
  @@index([tripId])
  @@index([status])
  @@index([bookingId])
}

model Booking {
  id                  String               @id @default(cuid())
  bookingCode         String               @unique
  customerName        String
  customerPhone       String
  customerEmail       String?
  pickupLat           Float?
  pickupLng           Float?
  tripId              String
  seatCount           Int
  subtotal            Decimal              @db.Decimal(12, 2)
  taxAmount           Decimal?             @db.Decimal(12, 2)
  totalAmount         Decimal              @db.Decimal(12, 2)
  platformFeeRate     Decimal?             @db.Decimal(5, 2)
  platformFeeAmount   Decimal?             @db.Decimal(12, 2)
  vendorAmount        Decimal?             @db.Decimal(12, 2)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus        @default(UNPAID)
  paidAt              DateTime?
  pgTransactionId     String?
  pgProvider          String?
  ewalletType         EWalletType?
  ewalletName         String?
  ewalletNo           String?
  status              BookingStatus        @default(PENDING)
  notes               String?
  expiresAt           DateTime?
  transferredFromId   String?              @unique
  billingId           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  billing             VendorBilling?       @relation(fields: [billingId], references: [id])
  transferredFrom     Booking?             @relation("BookingTransfer", fields: [transferredFromId], references: [id])
  transferredTo       Booking?             @relation("BookingTransfer")
  trip                Trip                 @relation(fields: [tripId], references: [id])
  refunds             Refund[]
  seats               TripSeat[]
  paymentTransactions PaymentTransaction[]

  @@index([tripId])
  @@index([customerPhone])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([billingId])
  @@index([createdAt])
}

model VendorBilling {
  id               String                 @id @default(cuid())
  invoiceNo        String                 @unique
  vendorId         String
  periodStart      DateTime
  periodEnd        DateTime
  dueDate          DateTime
  totalBookings    Int
  totalGrossAmount Decimal                @db.Decimal(14, 2)
  totalFeeAmount   Decimal                @db.Decimal(14, 2)
  paidAmount       Decimal                @default(0) @db.Decimal(14, 2)
  status           BillingStatus          @default(UNPAID)
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  bookings         Booking[]
  refundDeductions Refund[]               @relation("RefundDeduction")
  vendor           Vendor                 @relation(fields: [vendorId], references: [id])
  payments         VendorBillingPayment[]

  @@unique([vendorId, periodStart, periodEnd])
  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
}

model VendorBillingPayment {
  id            String        @id @default(cuid())
  billingId     String
  amount        Decimal       @db.Decimal(14, 2)
  method        String
  reference     String?
  notes         String?
  paidAt        DateTime      @default(now())
  processedById String?
  createdAt     DateTime      @default(now())
  billing       VendorBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  processedBy   User?         @relation("BillingProcessor", fields: [processedById], references: [id])

  @@index([billingId])
}

model VendorSettlement {
  id               String           @id @default(cuid())
  settlementNo     String           @unique
  vendorId         String
  periodStart      DateTime
  periodEnd        DateTime
  totalBookings    Int
  totalGrossAmount Decimal          @db.Decimal(14, 2)
  totalFeeAmount   Decimal          @db.Decimal(14, 2)
  totalPgFeeAmount Decimal          @db.Decimal(14, 2)
  netAmount        Decimal          @db.Decimal(14, 2)
  status           SettlementStatus @default(PENDING)
  settledAt        DateTime?
  reference        String?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  vendor           Vendor           @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([status])
  @@index([settledAt])
}

model Refund {
  id                      String         @id @default(cuid())
  refundCode              String         @unique
  bookingId               String
  originalAmount          Decimal        @db.Decimal(12, 2)
  refundPercentage        Decimal        @db.Decimal(5, 2)
  refundAmount            Decimal        @db.Decimal(12, 2)
  adminFee                Decimal?       @db.Decimal(12, 2)
  finalAmount             Decimal        @db.Decimal(12, 2)
  hoursBeforeDeparture    Int
  departureTime           DateTime
  requestedAt             DateTime       @default(now())
  refundMethod            RefundMethod
  customerBankName        String?
  customerBankAccount     String?
  customerBankAccountName String?
  status                  RefundStatus   @default(PENDING)
  reason                  String?
  rejectionReason         String?
  notes                   String?
  approvedAt              DateTime?
  processedAt             DateTime?
  completedAt             DateTime?
  processedById           String?
  deductedFromBillingId   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  booking                 Booking        @relation(fields: [bookingId], references: [id])
  deductedFromBilling     VendorBilling? @relation("RefundDeduction", fields: [deductedFromBillingId], references: [id])
  processedBy             User?          @relation("RefundProcessor", fields: [processedById], references: [id])

  @@index([bookingId])
  @@index([status])
  @@index([requestedAt])
}

// ═══════════════════════════════════════════════
// TRIP TEMPLATE (RECURRING SCHEDULE)
// ═══════════════════════════════════════════════

model TripTemplate {
  id                   String                 @id @default(cuid())
  vendorId             String
  name                 String
  origin               String
  destination          String
  originDetail         String?
  destinationDetail    String?
  originLat            Float?
  originLng            Float?
  price                Decimal                @db.Decimal(12, 2)
  amenities            Amenity[]              @default([])
  minBooking           Int                    @default(1)
  bookingDeadlineHours Int?
  notes                String?
  isActive             Boolean                @default(true)
  validFrom            DateTime?
  validUntil           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  vendor               Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  schedules            TripTemplateSchedule[]
  generatedTrips       Trip[]                 @relation("TripFromTemplate")

  @@index([vendorId])
  @@index([isActive])
  @@index([origin, destination])
}

model TripTemplateSchedule {
  id            String       @id @default(cuid())
  templateId    String
  vehicleId     String
  driverId      String?
  dayOfWeek     DayOfWeek
  departureTime String
  priceOverride Decimal?     @db.Decimal(12, 2)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  template      TripTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver        User?        @relation("DriverTemplateSchedules", fields: [driverId], references: [id])

  @@unique([templateId, vehicleId, dayOfWeek, departureTime])
  @@index([templateId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([dayOfWeek])
  @@index([isActive])
}

// ═══════════════════════════════════════════════
// FINANCIAL SYSTEM
// ═══════════════════════════════════════════════

// Saldo real-time vendor
model VendorWallet {
  id           String              @id @default(cuid())
  vendorId     String              @unique
  balance      Decimal             @default(0) @db.Decimal(14, 2)
  pendingIn    Decimal             @default(0) @db.Decimal(14, 2)
  debt         Decimal             @default(0) @db.Decimal(14, 2)
  totalEarned  Decimal             @default(0) @db.Decimal(14, 2)
  lockedAt     DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  transactions WalletTransaction[]
  withdrawals  WithdrawRequest[]
}

// Riwayat mutasi wallet
model WalletTransaction {
  id            String                @id @default(cuid())
  walletId      String
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(14, 2)
  balanceAfter  Decimal               @db.Decimal(14, 2)
  referenceId   String?
  referenceType String?
  description   String?
  createdAt     DateTime              @default(now())
  wallet        VendorWallet          @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}

// Audit trail keuangan (double-entry ledger)
model LedgerEntry {
  id            String        @id @default(cuid())
  transactionId String
  account       LedgerAccount
  side          LedgerSide
  amount        Decimal       @db.Decimal(14, 2)
  vendorId      String?
  referenceId   String?
  referenceType String?
  description   String?
  createdAt     DateTime      @default(now())

  @@index([transactionId])
  @@index([account])
  @@index([vendorId])
  @@index([referenceId])
  @@index([createdAt])
}

// Tracking interaksi dengan Payment Gateway (Midtrans)
model PaymentTransaction {
  id              String    @id @default(cuid())
  bookingId       String
  provider        String    @default("midtrans")
  externalId      String    @unique
  transactionId   String?
  paymentType     String?
  grossAmount     Decimal   @db.Decimal(14, 2)
  pgFeeAmount     Decimal?  @db.Decimal(14, 2)
  netAmount       Decimal?  @db.Decimal(14, 2)
  status          PgStatus  @default(PENDING)
  rawPayload      Json?
  callbackPayload Json?
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  booking         Booking   @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([externalId])
  @@index([status])
}

// Permintaan penarikan saldo vendor
model WithdrawRequest {
  id              String         @id @default(cuid())
  walletId        String
  vendorId        String
  amount          Decimal        @db.Decimal(14, 2)
  adminFee        Decimal        @default(0) @db.Decimal(14, 2)
  netAmount       Decimal        @db.Decimal(14, 2)
  bankName        String
  bankAccountNo   String
  bankAccountName String
  status          WithdrawStatus @default(PENDING)
  requestedAt     DateTime       @default(now())
  processedAt     DateTime?
  completedAt     DateTime?
  rejectedReason  String?
  reference       String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  wallet          VendorWallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([vendorId])
  @@index([status])
  @@index([requestedAt])
}

// ═══════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════

enum Gender {
  MALE
  FEMALE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TripStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum EWalletType {
  GOPAY
  OVO
  DANA
  SHOPEEPAY
  LINKAJA
  OTHER
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  BROKEN
  BLOCKED
}

enum PaymentMethod {
  CASH
  EWALLET
  TRANSFER
  BANK_TRANSFER
  CREDIT_CARD
  QRIS
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
  TRANSFERRED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  SETTLED
  HELD
}

enum BillingStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum RefundMethod {
  ORIGINAL
  BANK_TRANSFER
  CASH_PICKUP
  CREDIT
}

enum Amenity {
  AC
  TOLL
  USB
  BLANKET
  SNACK
  DRINK
  WIFI
  TV
  TOILET
  RECLINING_SEAT
  LEGROOM
  LUGGAGE
}

enum PolicyType {
  RESCHEDULE
  CANCELLATION
  REFUND
  LUGGAGE
  DEPARTURE
  DISCLAIMER
  OTHER
}

enum WalletTransactionType {
  BOOKING_INCOME
  CASH_INCOME
  PLATFORM_FEE
  REFUND_DEDUCTION
  WITHDRAW
  WITHDRAW_REVERSAL
  SETTLEMENT
  DEBT_PAYMENT
  ADJUSTMENT
}

enum LedgerAccount {
  PLATFORM_CASH
  PLATFORM_REVENUE
  VENDOR_WALLET
  VENDOR_CASH
  VENDOR_DEBT
  CUSTOMER_REFUND
  PG_RECEIVABLE
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum PgStatus {
  PENDING
  CHALLENGE
  SUCCESS
  SETTLEMENT
  DENY
  CANCEL
  EXPIRE
  FAILURE
  REFUND
}

enum WithdrawStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}
